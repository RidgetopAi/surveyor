{
  "name": "@surveyor/core",
  "version": "0.1.0",
  "description": "Surveyor parser and analysis engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "surveyor": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "commander": "^12.1.0",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^17.4.2",
    "glob": "^11.1.0",
    "knip": "^6.22.0",
    "ts-morph": "^24.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
