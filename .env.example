# Surveyor Environment Configuration
# Copy this file to .env and fill in your values

# LLM API Configuration (for behavioral analysis)
# Required for --analyze flag
SURVEYOR_LLM_API_KEY=your-api-key-here

# Optional: Override default endpoint (defaults to Grok/xAI)
# SURVEYOR_LLM_ENDPOINT=https://api.x.ai/v1/chat/completions

# Optional: Override default model
# Models: grok-4-1-fast-reasoning, grok-beta, grok-2, etc.
SURVEYOR_LLM_MODEL=grok-4-1-fast-reasoning

# Optional: Adjust LLM parameters
# SURVEYOR_LLM_MAX_TOKENS=256
# SURVEYOR_LLM_TEMPERATURE=0.1
# SURVEYOR_LLM_TIMEOUT=30000

# Concurrent LLM requests (default: 10, increase for faster analysis)
SURVEYOR_LLM_CONCURRENCY=10
