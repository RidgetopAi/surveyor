# Surveyor Environment Configuration
# Copy this file to .env and fill in your values.
#
# Behavioral analysis uses a PLUGGABLE LLM provider. Swapping provider/model is
# purely config — no code change. Defaults: provider=anthropic, model=claude-haiku-4-5.

# --- Provider selection -------------------------------------------------------
# anthropic (default) | openai-compatible
# SURVEYOR_LLM_PROVIDER=anthropic

# Model id. Default for anthropic: claude-haiku-4-5.
# SURVEYOR_LLM_MODEL=claude-haiku-4-5

# --- API key ------------------------------------------------------------------
# By default the key is read from ANTHROPIC_API_KEY (anthropic) or
# SURVEYOR_LLM_API_KEY (openai-compatible). Override which env var to read with
# SURVEYOR_LLM_API_KEY_ENV. A loopback openai-compatible endpoint (Ollama) needs
# no key by default.
ANTHROPIC_API_KEY=your-anthropic-key-here
# SURVEYOR_LLM_API_KEY=your-openai-compatible-key-here
# SURVEYOR_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
# SURVEYOR_LLM_API_KEY_REQUIRED=true

# --- OpenAI-compatible backends (xAI / OpenAI / local Ollama) -----------------
# Set provider=openai-compatible and a base URL. '/chat/completions' is appended
# if absent. Examples:
#   xAI:    https://api.x.ai/v1
#   Ollama: http://localhost:11434/v1   (free, self-hosted, no API key)
# SURVEYOR_LLM_PROVIDER=openai-compatible
# SURVEYOR_LLM_BASE_URL=http://localhost:11434/v1
# SURVEYOR_LLM_MODEL=qwen2.5:1.5b
# SURVEYOR_LLM_TEMPERATURE=0.1   # only sent for openai-compatible backends

# --- Tunables (all optional) --------------------------------------------------
# SURVEYOR_LLM_MAX_TOKENS=1024
# SURVEYOR_LLM_TIMEOUT=30000
# SURVEYOR_LLM_CONCURRENCY=5
# SURVEYOR_LLM_MAX_CODE_LENGTH=2000
# SURVEYOR_LLM_MAX_RETRIES=2
# SURVEYOR_LLM_SYSTEM_PROMPT="<override the default behavioral-summary system prompt>"

# =============================================================================
# Surveyor API server (@surveyor/server) — the deployable shared service
# =============================================================================
# All server tunables are named config (see packages/server/src/config.ts);
# nothing reads process.env directly outside that file.

# --- Network ------------------------------------------------------------------
# SURVEYOR_PORT=4000

# --- Auth (REQUIRED for the shared service) -----------------------------------
# Bearer token Mandrel presents on every /api/v1 call. If UNSET the server fails
# CLOSED: every /api/v1 route returns 503 until a token is configured. Health is
# always unauthenticated.
# SURVEYOR_AUTH_TOKEN=change-me-to-a-long-random-secret

# --- CORS (exact allowlist, NO substring match) -------------------------------
# Comma-separated. An entry beginning with '.' (e.g. .ridgetopai.net) matches the
# apex + any subdomain via a host-boundary suffix check; any other entry must
# match the browser Origin EXACTLY (scheme+host+port). Empty => no browser origin
# allowed (non-browser callers like Mandrel don't send Origin and are unaffected).
# SURVEYOR_CORS_ORIGINS=.ridgetopai.net,http://localhost:5173

# --- Bounded job store (NOT the system-of-record; Mandrel persists in P4b) -----
# SURVEYOR_JOB_TTL_MS=1800000            # 30 min — max lifetime of any job
# SURVEYOR_MAX_JOBS=100                   # hard ceiling on tracked jobs
# SURVEYOR_EVICT_AFTER_RESULT=true       # drop a job once its result is retrieved
# SURVEYOR_STORE_SWEEP_INTERVAL_MS=60000 # background TTL sweep cadence

# --- Resource limits (RAM-ceiling safety) -------------------------------------
# SURVEYOR_MAX_CONCURRENT_JOBS=2         # scans run at most this many at once
# SURVEYOR_MAX_QUEUED_JOBS=50            # reject new jobs beyond this backlog (503)
# SURVEYOR_SCAN_TIMEOUT_MS=600000        # 10 min per scan, then the job is failed
# SURVEYOR_MAX_REPO_BYTES=536870912      # 512 MB scannable source → reject (413)
# SURVEYOR_MAX_FILE_COUNT=50000          # file-count ceiling → reject (413)
# SURVEYOR_IGNORE_DIRS=node_modules,.git,dist,build,.surveyor,coverage,.next

# --- Per-job workspace --------------------------------------------------------
# Scan outputs + AI cache are written HERE, never inside the scanned tree.
# Default: <os tmpdir>/surveyor-jobs
# SURVEYOR_WORKSPACE_DIR=/var/tmp/surveyor-jobs
