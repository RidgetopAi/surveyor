# Surveyor Environment Configuration
# Copy this file to .env and fill in your values.
#
# Behavioral analysis uses a PLUGGABLE LLM provider. Swapping provider/model is
# purely config — no code change. Defaults: provider=anthropic, model=claude-haiku-4-5.

# --- Provider selection -------------------------------------------------------
# anthropic (default) | openai-compatible
# SURVEYOR_LLM_PROVIDER=anthropic

# Model id. Default for anthropic: claude-haiku-4-5.
# SURVEYOR_LLM_MODEL=claude-haiku-4-5

# --- API key ------------------------------------------------------------------
# By default the key is read from ANTHROPIC_API_KEY (anthropic) or
# SURVEYOR_LLM_API_KEY (openai-compatible). Override which env var to read with
# SURVEYOR_LLM_API_KEY_ENV. A loopback openai-compatible endpoint (Ollama) needs
# no key by default.
ANTHROPIC_API_KEY=your-anthropic-key-here
# SURVEYOR_LLM_API_KEY=your-openai-compatible-key-here
# SURVEYOR_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
# SURVEYOR_LLM_API_KEY_REQUIRED=true

# --- OpenAI-compatible backends (xAI / OpenAI / local Ollama) -----------------
# Set provider=openai-compatible and a base URL. '/chat/completions' is appended
# if absent. Examples:
#   xAI:    https://api.x.ai/v1
#   Ollama: http://localhost:11434/v1   (free, self-hosted, no API key)
# SURVEYOR_LLM_PROVIDER=openai-compatible
# SURVEYOR_LLM_BASE_URL=http://localhost:11434/v1
# SURVEYOR_LLM_MODEL=qwen2.5:1.5b
# SURVEYOR_LLM_TEMPERATURE=0.1   # only sent for openai-compatible backends

# --- Tunables (all optional) --------------------------------------------------
# SURVEYOR_LLM_MAX_TOKENS=1024
# SURVEYOR_LLM_TIMEOUT=30000
# SURVEYOR_LLM_CONCURRENCY=5
# SURVEYOR_LLM_MAX_CODE_LENGTH=2000
# SURVEYOR_LLM_MAX_RETRIES=2
# SURVEYOR_LLM_SYSTEM_PROMPT="<override the default behavioral-summary system prompt>"
